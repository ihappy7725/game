"""게임화 ("미국 정복") 백엔드 - 보관본 (main.py 에 아직 연결되지 않음)

이 모듈은 main.py 에서 분리해 둔 구현입니다. 같은 기능을 다른 세션이
main.py 안에 먼저 구현해 라우트 경로가 8개 겹쳤기 때문에, main.py 가
깨지지 않도록 이쪽을 떼어냈습니다. 둘 중 무엇을 쓸지는 사용자가
고릅니다. 자세한 비교는 GAMIFICATION_BACKEND.md 를 보세요.

이 구현을 쓰려면:
  1) main.py 안의 다른 게임화 블록(“게임화: 코인 원장 · 티어 …”)을 지우고
  2) 이 파일 내용을 main.py 끝에 붙이고
  3) supabase_gamification_states.sql 을 Supabase SQL Editor 에서 실행하세요.
     (supabase_gamification.sql 이 아니라 _states 쪽입니다)
"""

# ---------------------------------------------------------------------------
# 게임화 ("미국 정복") - 코인 / 티어 / 가챠 / 리더보드 / 오답 보스 레이드
#
# DDL은 supabase_gamification.sql 에 있습니다. 이 블록의 상수(티어 기준,
# 코인 규칙, 가챠 확률)는 전부 서버에만 존재하며 클라이언트에 내려주지
# 않습니다.
# ---------------------------------------------------------------------------


class Tier(NamedTuple):
    """미국 정복 5단계 티어 한 칸."""

    level: int
    code: str
    name: str
    emoji: str
    min_xp: int


# 티어 승급 기준 - 숫자의 근거
#   XP는 "채점을 한 번 끝낸다 = 30 XP"를 기준 단위로 삼았다
#   (COIN_RULES 의 writing_submission / speaking_submission 과 동일).
#   즉 아래 기준은 각각 대략 이만큼의 채점 횟수에 해당한다.
#     150 XP  ≈  5회   -> 가입 첫 주에 바로 한 번 승급해서 "시작했다"는 감각을 준다
#     600 XP  ≈ 20회   -> 하루 1~2회 페이스로 약 2주
#    1800 XP  ≈ 60회   -> 약 1~2개월 (실제 토플 준비 기간의 중반)
#    4000 XP  ≈ 133회  -> 약 3개월, 시험 직전. 마지막 티어는 쉽게 닿지 않아야 한다
#   게임/보스 레이드 XP는 1회당 5 XP로 작게 잡아, 학습이 아닌 경로로
#   티어를 올리는 속도가 학습 경로를 넘지 못하게 했다.
TIER_THRESHOLDS: Tuple[Tier, ...] = (
    Tier(1, "departure",    "인천 출국 준비생",  "🛫",    0),
    Tier(2, "jfk_arrival",  "JFK 입국자",        "✈️",  150),
    Tier(3, "manhattan",    "맨해튼 유학생",     "🚇",  600),
    Tier(4, "columbia",     "컬럼비아 연구원",   "🏛️", 1800),
    Tier(5, "ivy_graduate", "아이비리그 졸업생", "🎓", 4000),
)

# 승급 축하금 = 새 티어 레벨 x 이 값. 승급은 서버가 xp 변화를 보고 판정하므로
# 클라이언트가 "나 승급했어"라고 주장할 수 있는 경로는 없다.
TIER_UP_BONUS_PER_LEVEL = 250


class CoinRule(NamedTuple):
    """코인 변동 사유 하나에 대한 서버 측 규칙.

    amount        : 고정 지급/차감액 (양수=획득, 음수=소비).
                    variable=True 면 "1회 최대액"으로 해석한다.
    variable      : 클라이언트가 금액을 제안할 수 있는가. 제안값은 항상
                    1..|amount| 로 깎인다. 그대로 믿는 경로는 없다.
    daily_cap     : 같은 사유의 하루(UTC) 획득 상한. None 이면 상한 없음.
                    실제 집계와 차감은 DB 함수 안에서 행을 잠근 채 처리된다.
    xp            : 이 사유로 올라가는 XP (티어 계산의 재료).
    requires_ref  : 보상의 근거가 되는 행 종류. 서버가 소유권과
                    "이미 보상했는지"를 직접 확인한다.
    """

    label: str
    amount: int
    variable: bool
    daily_cap: Optional[int]
    xp: int
    requires_ref: Optional[Literal["submission"]] = None


# 클라이언트가 POST /api/game/coins 로 직접 요청할 수 있는 사유만 여기에 둔다.
COIN_RULES: Dict[str, CoinRule] = {
    # 학습 보상: submission_id 를 반드시 받아서 본인 제출물인지, 섹션이 맞는지,
    # 이미 보상한 제출물이 아닌지까지 확인한 뒤 지급한다.
    "writing_submission":  CoinRule("라이팅 채점 완료", 30, False, 150, 30, "submission"),
    "speaking_submission": CoinRule("스피킹 채점 완료", 30, False, 150, 30, "submission"),
    # 하루 첫 접속. daily_cap 이 지급액과 같으므로 두 번째 호출은 0원이 된다.
    "daily_login":         CoinRule("하루 첫 접속", 50, False, 50, 0, None),
    # 아케이드 게임 보상. 서버가 게임 로직을 모르므로 금액은 클라이언트 제안값이다.
    # 1회 최대액과 하루 상한으로만 막는다 (아래 "남은 신뢰 경계" 주석 참고).
    "game_clear":          CoinRule("아케이드 게임 클리어", 100, True, 300, 5, None),
    "boss_damage":         CoinRule("보스 레이드 피해량", 50, True, 200, 5, None),
    # 소비: 기숙사 배치 초기화
    "dorm_reroll":         CoinRule("기숙사 배치 초기화", -50, False, None, 0, None),
}

# 서버 내부에서만 쓰는 사유. POST /api/game/coins 로 들어오면 거부한다.
#   streak_bonus / tier_up        : 서버가 조건을 판정해 지급
#   mistake_cleared               : 오답 재도전 엔드포인트가 정답을 확인한 뒤 지급
#   gacha_pull                    : pull_gacha() 함수만 기록
#   bet_stake / bet_win / bet_forfeit
#        : 월스트리트 배팅. 정산(settle) 엔드포인트가 아직 없으므로 배팅을
#          여기서 열어 주면 걸린 코인을 돌려줄 방법이 없다. 정산이 구현될
#          때까지 서버 전용으로 잠가 둔다.
#   admin_grant / admin_revoke    : 운영 보정
SERVER_ONLY_REASONS = frozenset({
    "streak_bonus", "tier_up", "mistake_cleared", "gacha_pull",
    "bet_stake", "bet_win", "bet_forfeit", "admin_grant", "admin_revoke",
})

# 오답을 극복했을 때 지급하는 코인/XP (오답 1건당 한 번만)
MISTAKE_CLEARED_COINS = 15
MISTAKE_CLEARED_XP = 10
MISTAKE_CLEARED_DAILY_CAP = 150

# 가챠: 1회 비용과 등급별 가중치. 확률 테이블은 서버에만 있고 어떤 응답에도
# 포함되지 않는다. 클라이언트가 보는 것은 rarity 등급명까지다.
GACHA_COST_PER_PULL = 300
GACHA_MAX_PULLS = 10
GACHA_RARITY_WEIGHTS: Dict[str, int] = {
    "common": 60,
    "rare": 28,
    "epic": 10,
    "legendary": 2,
}

# 기숙사에 한 번에 배치/수정할 수 있는 오브젝트 수
MAX_PLACEMENT_ITEMS = 32

# 리더보드 기본/최대 노출 인원
LEADERBOARD_DEFAULT_LIMIT = 20
LEADERBOARD_MAX_LIMIT = 100

# 가챠 뽑기는 암호학적으로 안전한 난수를 쓴다. 코인이 걸린 추첨이므로
# 시드를 추측해 결과를 예측할 수 있는 random 기본 인스턴스는 쓰지 않는다.
_gacha_rng = random.SystemRandom()


# ---------------------------------------------------------------------------
# 게임화 내부 헬퍼
# ---------------------------------------------------------------------------


def _tier_for_xp(xp: int) -> Tier:
    """누적 XP에 해당하는 티어를 돌려준다 (기준은 TIER_THRESHOLDS 한 곳에만 있다)."""
    current = TIER_THRESHOLDS[0]
    for tier in TIER_THRESHOLDS:
        if xp >= tier.min_xp:
            current = tier
        else:
            break
    return current


def _next_tier(tier: Tier) -> Optional[Tier]:
    """다음 티어 (최고 티어면 None)."""
    for candidate in TIER_THRESHOLDS:
        if candidate.level == tier.level + 1:
            return candidate
    return None


def _gamification_db_error(exc: Exception, action: str) -> HTTPException:
    """Supabase 오류를 사용자에게 설명 가능한 HTTP 오류로 바꾼다.

    게임화 테이블/함수는 supabase_gamification.sql 을 실행해야 생기므로,
    "없다"는 오류는 502가 아니라 503으로 올려 원인을 분명히 알려 준다.
    """
    message = str(exc)
    if "PGRST205" in message or "PGRST202" in message or "Could not find the function" in message:
        return HTTPException(
            status_code=503,
            detail=(
                f"{action} 실패: 게임화 테이블/함수가 없습니다. "
                "Supabase SQL Editor에서 supabase_gamification.sql 을 실행해 주세요."
            ),
        )
    if "INSUFFICIENT_FUNDS" in message:
        return HTTPException(status_code=409, detail="코인이 부족합니다.")
    if "violates foreign key constraint" in message and "game_states" in message:
        return HTTPException(
            status_code=409,
            detail="프로필이 아직 없습니다. 로그인 후 다시 시도해 주세요.",
        )
    logger.exception("%s 실패", action)
    return HTTPException(status_code=502, detail=f"{action}에 실패했습니다: {exc}")


def _call_rpc(client: Client, function_name: str, params: Dict[str, Any], action: str) -> Any:
    """Postgres 함수를 호출한다 (한 번의 호출 = 한 트랜잭션)."""
    try:
        response = client.rpc(function_name, params).execute()
    except Exception as exc:
        raise _gamification_db_error(exc, action) from exc
    return getattr(response, "data", None)


def _int_or_zero(value: Any) -> int:
    """PostgREST가 bigint를 문자열로 돌려주는 경우까지 안전하게 int로 바꾼다."""
    if value is None or value == "":
        return 0
    try:
        return int(value)
    except (TypeError, ValueError):
        return 0


def _fetch_game_row(client: Client, user_id: str) -> Dict[str, Any]:
    """game_states 한 줄을 읽는다. 아직 없으면 0으로 채운 기본값을 돌려준다.

    조회만으로 행을 만들지는 않는다. 첫 코인 변동 때 DB 함수가 만들어 준다.
    """
    try:
        response = (
            client.table("game_states").select("*").eq("user_id", user_id).limit(1).execute()
        )
    except Exception as exc:
        raise _gamification_db_error(exc, "게임 상태 조회") from exc

    rows = getattr(response, "data", None) or []
    if rows:
        return rows[0]
    return {
        "user_id": user_id,
        "coin_balance": 0,
        "total_earned": 0,
        "total_spent": 0,
        "xp": 0,
        "tier_level": TIER_THRESHOLDS[0].level,
        "streak_days": 0,
        "best_streak_days": 0,
        "last_active_date": None,
    }


def _sync_tier_cache(client: Client, user_id: str, row: Dict[str, Any], tier: Tier) -> None:
    """game_states.tier_level 캐시를 계산된 티어와 맞춘다 (실패해도 조회는 계속)."""
    if _int_or_zero(row.get("tier_level")) == tier.level:
        return
    try:
        client.table("game_states").update({"tier_level": tier.level}).eq(
            "user_id", user_id
        ).execute()
        row["tier_level"] = tier.level
    except Exception:
        # 캐시일 뿐이므로 실패를 사용자에게 전가하지 않는다. 응답의 티어는
        # 언제나 xp로 다시 계산한 값이다.
        logger.warning("티어 캐시 갱신 실패 (user_id=%s)", user_id)


def _question_key(section: str, question_prompt: str) -> str:
    """같은 문제를 같은 행으로 모으기 위한 키.

    클라이언트가 임의의 키를 보내면 남의 행과 충돌시키거나 보상을 중복으로
    받을 수 있으므로, 키는 항상 서버가 지문을 정규화해 해시한다.
    """
    normalized = " ".join((question_prompt or "").split()).lower()
    digest = hashlib.sha256(f"{section}|{normalized}".encode("utf-8")).hexdigest()
    return digest[:40]


def _roll_gacha(catalog: List[Dict[str, Any]], pulls: int) -> List[Dict[str, Any]]:
    """등급 가중치로 뽑은 뒤 그 등급 안에서 균등 추첨한다.

    확률 테이블(GACHA_RARITY_WEIGHTS)은 서버에만 있고 응답에 포함되지 않는다.
    """
    by_rarity: Dict[str, List[Dict[str, Any]]] = {}
    for item in catalog:
        by_rarity.setdefault(str(item.get("rarity")), []).append(item)

    # 카탈로그에 실제로 존재하는 등급만 후보로 삼는다. 아이템이 없는 등급의
    # 가중치를 그대로 쓰면 뽑기가 실패하거나 확률이 왜곡된다.
    candidates = [(r, w) for r, w in GACHA_RARITY_WEIGHTS.items() if by_rarity.get(r)]
    if not candidates:
        raise HTTPException(
            status_code=503,
            detail="가챠 카탈로그가 비어 있습니다. supabase_gamification.sql 의 시드 데이터를 확인해 주세요.",
        )

    rarities = [r for r, _ in candidates]
    weights = [w for _, w in candidates]
    results: List[Dict[str, Any]] = []
    for _ in range(pulls):
        rarity = _gacha_rng.choices(rarities, weights=weights, k=1)[0]
        results.append(_gacha_rng.choice(by_rarity[rarity]))
    return results


# ---------------------------------------------------------------------------
# 게임화 요청/응답 스키마
# ---------------------------------------------------------------------------


class TierInfo(BaseModel):
    """메뉴바 배지에 쓰는 티어 정보 (항상 xp로 다시 계산한 값)."""

    level: int
    code: str
    name: str
    emoji: str
    min_xp: int
    next_level_xp: Optional[int] = Field(default=None, description="다음 티어 기준 XP (최고 티어면 null)")
    xp_into_tier: int = Field(description="현재 티어 안에서 쌓은 XP")
    xp_to_next: Optional[int] = Field(default=None, description="다음 티어까지 남은 XP")
    progress: float = Field(description="현재 티어 구간의 진행도 (0.0~1.0, 최고 티어는 1.0)")


class GameStateResponse(BaseModel):
    coins: int = Field(description="보유 코인 (메뉴바의 💵 값)")
    total_earned: int
    total_spent: int
    xp: int
    tier: TierInfo
    streak_days: int
    best_streak_days: int
    last_active_date: Optional[date] = None


class CoinChangeRequest(BaseModel):
    reason: str = Field(description="COIN_RULES 에 정의된 사유 (서버 전용 사유는 거부)")
    amount: Optional[int] = Field(
        default=None,
        ge=1,
        le=100000,
        description="변동폭이 있는 사유의 제안값(절대값). 서버가 1회 최대액으로 깎는다",
    )
    submission_id: Optional[str] = Field(
        default=None, description="학습 보상의 근거가 되는 제출 기록 ID"
    )
    note: Optional[str] = Field(default=None, max_length=200, description="원장에 남길 메모")


class CoinChangeResponse(BaseModel):
    reason: str
    label: str
    requested: int = Field(description="서버가 규칙으로 정한(또는 깎은) 요청 금액")
    applied: int = Field(description="실제로 반영된 금액. 상한에 걸리면 요청보다 작다")
    capped: bool = Field(description="하루 상한에 걸려 금액이 깎였는지")
    cap_remaining: Optional[int] = Field(default=None, description="오늘 이 사유로 더 받을 수 있는 금액")
    tier_up: bool = Field(default=False, description="이 변동으로 티어가 올라갔는지")
    tier_up_bonus: int = Field(default=0, description="승급 축하금")
    state: GameStateResponse


class GachaRequest(BaseModel):
    pulls: int = Field(default=1, ge=1, le=GACHA_MAX_PULLS, description="뽑기 횟수")


class GachaResultItem(BaseModel):
    code: str
    name: str
    emoji: str
    rarity: str
    description: Optional[str] = None
    is_new: bool = Field(description="이번 뽑기로 처음 획득한 아이템인지")


class GachaResponse(BaseModel):
    results: List[GachaResultItem]
    pulls: int
    cost_per_pull: int
    spent: int
    state: GameStateResponse


class InventoryItem(BaseModel):
    code: str
    name: str
    emoji: str
    rarity: str
    description: Optional[str] = None
    quantity: int = Field(description="보유 수량 (0이면 아직 미획득)")
    is_placed: bool = False
    pos_x: Optional[float] = Field(default=None, description="책상 위 가로 위치 (0~1)")
    pos_y: Optional[float] = Field(default=None, description="책상 위 세로 위치 (0~1)")
    z_index: int = 0


class InventoryResponse(BaseModel):
    items: List[InventoryItem] = Field(description="카탈로그 전체 (미획득 아이템은 quantity=0)")
    owned_count: int = Field(description="한 개 이상 보유한 아이템 종류 수")
    catalog_count: int
    placed_count: int
    cost_per_pull: int


class PlacementInput(BaseModel):
    item_code: str = Field(max_length=64)
    is_placed: bool = True
    pos_x: Optional[float] = Field(default=None, ge=0.0, le=1.0)
    pos_y: Optional[float] = Field(default=None, ge=0.0, le=1.0)
    z_index: int = Field(default=0, ge=0, le=99)


class PlacementRequest(BaseModel):
    items: List[PlacementInput] = Field(min_length=1, max_length=MAX_PLACEMENT_ITEMS)


class LeaderboardEntry(BaseModel):
    rank: int
    display_name: str = Field(description="프로필 이름(없으면 익명 라벨). 이메일은 내려주지 않는다")
    tier_level: int
    tier_name: str
    tier_emoji: str
    coins_earned: int = Field(description="이번 주에 획득한 코인")
    attempts: int = Field(description="이번 주 채점 횟수")
    avg_score: Optional[float] = None
    streak_days: int
    is_me: bool = False


class LeaderboardResponse(BaseModel):
    entries: List[LeaderboardEntry]
    me: Optional[LeaderboardEntry] = Field(default=None, description="상위권 밖이어도 본인 순위는 함께 내려준다")
    week_start_at: Optional[datetime] = Field(default=None, description="집계 시작 시각 (월요일 00:00 UTC)")
    limit: int


class MistakeItem(BaseModel):
    id: str
    section: str
    question_prompt: Optional[str] = None
    user_answer: Optional[str] = None
    correct_answer: Optional[str] = None
    explanation: Optional[str] = None
    mistake_count: int
    retry_count: int
    last_wrong_at: datetime
    last_correct_at: Optional[datetime] = None
    resolved: bool = Field(description="한 번이라도 다시 맞혔는지 (보스 레이드 대상에서 제외)")


class MistakeListResponse(BaseModel):
    items: List[MistakeItem]
    unresolved_count: int = Field(description="아직 극복하지 못한 오답 수 (= 보스 HP의 재료)")
    limit: int


class MistakeCreateRequest(BaseModel):
    section: Literal["writing", "speaking", "reading", "listening", "vocabulary"]
    question_prompt: str = Field(min_length=1, max_length=4000)
    user_answer: Optional[str] = Field(default=None, max_length=4000)
    correct_answer: Optional[str] = Field(default=None, max_length=4000)
    explanation: Optional[str] = Field(default=None, max_length=4000)
    submission_id: Optional[str] = None


class MistakeRetryRequest(BaseModel):
    correct: bool = Field(description="재도전에서 맞혔는지")


class MistakeRetryResponse(BaseModel):
    mistake: MistakeItem
    coins_awarded: int = Field(description="극복 보상 (이미 받았거나 틀렸으면 0)")
    state: GameStateResponse


# ---------------------------------------------------------------------------
# 게임화 응답 조립
# ---------------------------------------------------------------------------


def _tier_info(xp: int) -> TierInfo:
    """XP로 티어와 진행도를 계산한다 (승급 기준은 TIER_THRESHOLDS 한 곳)."""
    tier = _tier_for_xp(xp)
    following = _next_tier(tier)
    xp_into_tier = max(0, xp - tier.min_xp)
    if following is None:
        return TierInfo(
            level=tier.level,
            code=tier.code,
            name=tier.name,
            emoji=tier.emoji,
            min_xp=tier.min_xp,
            next_level_xp=None,
            xp_into_tier=xp_into_tier,
            xp_to_next=None,
            progress=1.0,
        )
    span = following.min_xp - tier.min_xp
    return TierInfo(
        level=tier.level,
        code=tier.code,
        name=tier.name,
        emoji=tier.emoji,
        min_xp=tier.min_xp,
        next_level_xp=following.min_xp,
        xp_into_tier=xp_into_tier,
        xp_to_next=max(0, following.min_xp - xp),
        progress=round(min(1.0, xp_into_tier / span), 4) if span > 0 else 1.0,
    )


def _game_state_response(row: Dict[str, Any]) -> GameStateResponse:
    """game_states 한 줄을 응답 모델로 바꾼다. 티어는 항상 xp로 다시 계산한다."""
    xp = _int_or_zero(row.get("xp"))
    raw_date = row.get("last_active_date")
    last_active: Optional[date] = None
    if raw_date:
        try:
            last_active = date.fromisoformat(str(raw_date)[:10])
        except ValueError:
            last_active = None
    return GameStateResponse(
        coins=_int_or_zero(row.get("coin_balance")),
        total_earned=_int_or_zero(row.get("total_earned")),
        total_spent=_int_or_zero(row.get("total_spent")),
        xp=xp,
        tier=_tier_info(xp),
        streak_days=_int_or_zero(row.get("streak_days")),
        best_streak_days=_int_or_zero(row.get("best_streak_days")),
        last_active_date=last_active,
    )


def _mistake_item(row: Dict[str, Any]) -> MistakeItem:
    return MistakeItem(
        id=str(row["id"]),
        section=row["section"],
        question_prompt=row.get("question_prompt"),
        user_answer=row.get("user_answer"),
        correct_answer=row.get("correct_answer"),
        explanation=row.get("explanation"),
        mistake_count=_int_or_zero(row.get("mistake_count")),
        retry_count=_int_or_zero(row.get("retry_count")),
        last_wrong_at=row["last_wrong_at"],
        last_correct_at=row.get("last_correct_at"),
        resolved=row.get("last_correct_at") is not None,
    )


def _already_rewarded(
    client: Client, user_id: str, reason: str, json_field: str, reference_id: str
) -> bool:
    """같은 근거(제출물/오답)로 이미 코인을 받았는지 원장에서 확인한다.

    같은 제출물로 보상을 반복해서 받는 가장 쉬운 치트를 막는 지점이다.
    """
    try:
        response = (
            client.table("coin_ledger")
            .select("id")
            .eq("user_id", user_id)
            .eq("reason", reason)
            .eq(f"metadata->>{json_field}", reference_id)
            .limit(1)
            .execute()
        )
    except Exception as exc:
        raise _gamification_db_error(exc, "중복 보상 확인") from exc
    return bool(getattr(response, "data", None))


def _verify_submission(client: Client, user_id: str, submission_id: str, section: str) -> None:
    """보상 근거가 본인의, 해당 섹션의 실제 제출물인지 확인한다."""
    try:
        response = (
            client.table("submissions")
            .select("id, section")
            .eq("id", submission_id)
            .eq("user_id", user_id)
            .limit(1)
            .execute()
        )
    except Exception as exc:
        # UUID 형식이 아니면 PostgREST에서 오류가 난다. 존재 여부를 흘리지 않도록 400으로 정리한다.
        logger.warning("보상 근거 제출물 확인 실패 (%s): %s", submission_id, exc)
        raise HTTPException(status_code=400, detail="보상 근거가 되는 제출 기록을 찾을 수 없습니다.") from exc

    rows = getattr(response, "data", None) or []
    if not rows:
        raise HTTPException(status_code=400, detail="보상 근거가 되는 제출 기록을 찾을 수 없습니다.")
    if rows[0].get("section") != section:
        raise HTTPException(
            status_code=400,
            detail=f"제출 기록의 섹션({rows[0].get('section')})이 보상 사유와 맞지 않습니다.",
        )


def _apply_coins(
    client: Client,
    user_id: str,
    amount: int,
    reason: str,
    daily_cap: Optional[int],
    xp: int,
    metadata: Dict[str, Any],
) -> Dict[str, Any]:
    """apply_coin_change() 호출 결과를 dict로 돌려준다."""
    payload = _call_rpc(
        client,
        "apply_coin_change",
        {
            "p_user_id": user_id,
            "p_amount": amount,
            "p_reason": reason,
            "p_daily_cap": daily_cap,
            "p_xp": xp,
            "p_metadata": metadata,
        },
        "코인 변동 처리",
    )
    if not isinstance(payload, dict) or "state" not in payload:
        raise HTTPException(status_code=502, detail="코인 변동 결과를 해석할 수 없습니다.")
    return payload


# ---------------------------------------------------------------------------
# 게임화 라우터
# ---------------------------------------------------------------------------


@app.get("/api/game/state", response_model=GameStateResponse)
async def get_game_state(authorization: Optional[str] = Header(default=None)):
    """메뉴바가 쓰는 코인·티어·연속 학습일을 돌려준다.

    티어는 저장된 캐시를 믿지 않고 항상 xp로 다시 계산한다. 캐시가 어긋나 있으면
    맞춰 주지만, 조회(GET)에서 코인을 지급하지는 않는다. 승급 축하금은 xp가
    실제로 올라가는 POST /api/game/coins 에서만 지급된다.
    """
    client = _require_supabase()
    user_id = _require_user_id(authorization)

    row = _fetch_game_row(client, user_id)
    tier = _tier_for_xp(_int_or_zero(row.get("xp")))
    _sync_tier_cache(client, user_id, row, tier)
    return _game_state_response(row)


@app.post("/api/game/coins", response_model=CoinChangeResponse)
async def change_coins(
    payload: CoinChangeRequest,
    authorization: Optional[str] = Header(default=None),
):
    """코인을 획득/소비한다. 금액은 전부 서버가 결정한다.

    클라이언트가 보낸 amount를 그대로 더하는 경로는 없다.
      - 고정 사유: 요청의 amount는 아예 무시하고 COIN_RULES 값을 쓴다.
      - 변동 사유: 1..규칙의 1회 최대액으로 깎는다.
      - 사유별 하루 상한은 DB 함수가 행을 잠근 채 집계하므로 동시 요청으로
        우회할 수 없다.
      - 학습 보상은 submission_id의 소유권·섹션·중복 보상까지 확인한다.
    """
    client = _require_supabase()
    user_id = _require_user_id(authorization)

    reason = payload.reason
    if reason in SERVER_ONLY_REASONS:
        raise HTTPException(
            status_code=403,
            detail=f"'{reason}'는 서버가 직접 지급하는 사유여서 요청할 수 없습니다.",
        )
    rule = COIN_RULES.get(reason)
    if rule is None:
        raise HTTPException(
            status_code=400,
            detail=f"알 수 없는 코인 사유입니다. 사용 가능: {', '.join(sorted(COIN_RULES))}",
        )

    # 1) 금액 결정 - 클라이언트 제안값은 여기서 반드시 깎인다
    if rule.variable:
        proposed = payload.amount if payload.amount is not None else abs(rule.amount)
        magnitude = min(abs(int(proposed)), abs(rule.amount))
        if magnitude <= 0:
            raise HTTPException(status_code=400, detail="변동 금액은 1 이상이어야 합니다.")
    else:
        magnitude = abs(rule.amount)
    signed_amount = magnitude if rule.amount > 0 else -magnitude

    # 2) 보상 근거 검증 (본인 제출물인지 / 이미 보상했는지)
    metadata: Dict[str, Any] = {"label": rule.label}
    if payload.note:
        metadata["note"] = payload.note
    if rule.requires_ref == "submission":
        if not payload.submission_id:
            raise HTTPException(
                status_code=400,
                detail=f"'{reason}' 보상에는 submission_id가 필요합니다.",
            )
        section = "writing" if reason == "writing_submission" else "speaking"
        _verify_submission(client, user_id, payload.submission_id, section)
        if _already_rewarded(client, user_id, reason, "submission_id", payload.submission_id):
            raise HTTPException(
                status_code=409, detail="이 제출 기록으로는 이미 코인을 받았습니다."
            )
        metadata["submission_id"] = payload.submission_id
    elif payload.submission_id:
        # 근거가 필요 없는 사유에 붙은 submission_id는 추적용으로만 남긴다
        metadata["submission_id"] = payload.submission_id

    # 3) 반영 (원장 기록 + 잔액 갱신 + xp 증가가 한 트랜잭션)
    before_xp = _int_or_zero(_fetch_game_row(client, user_id).get("xp"))
    result = _apply_coins(
        client, user_id, signed_amount, reason, rule.daily_cap, rule.xp, metadata
    )
    state_row: Dict[str, Any] = result["state"]

    # 4) 획득이었다면 활동일(streak)을 갱신하고, 티어가 올라갔으면 축하금을 지급한다
    tier_up = False
    bonus = 0
    if signed_amount > 0:
        after_xp = _int_or_zero(state_row.get("xp"))
        new_tier = _tier_for_xp(after_xp)
        tier_up = new_tier.level > _tier_for_xp(before_xp).level
        if tier_up:
            bonus = TIER_UP_BONUS_PER_LEVEL * new_tier.level
            bonus_result = _apply_coins(
                client, user_id, bonus, "tier_up", None, 0,
                {"label": "티어 승급 축하금", "tier_level": new_tier.level, "tier_code": new_tier.code},
            )
            state_row = bonus_result["state"]
        activity = _call_rpc(
            client,
            "touch_activity",
            {"p_user_id": user_id, "p_xp": 0, "p_tier_level": new_tier.level},
            "활동 기록 갱신",
        )
        if isinstance(activity, dict):
            state_row = activity

    return CoinChangeResponse(
        reason=reason,
        label=rule.label,
        requested=signed_amount,
        applied=_int_or_zero(result.get("applied")),
        capped=bool(result.get("capped")),
        cap_remaining=(
            None if result.get("cap_remaining") is None else _int_or_zero(result.get("cap_remaining"))
        ),
        tier_up=tier_up,
        tier_up_bonus=bonus,
        state=_game_state_response(state_row),
    )


@app.post("/api/game/gacha", response_model=GachaResponse)
async def pull_gacha(
    payload: GachaRequest,
    authorization: Optional[str] = Header(default=None),
):
    """기숙사 오브젝트를 뽑는다.

    확률 테이블은 서버에만 있고 응답에 포함되지 않는다. 차감과 지급은
    pull_gacha() 함수 안에서 한 트랜잭션으로 처리되므로, 지급이 실패하면
    차감도 함께 롤백된다. 잔액이 부족하면 409로 거부하고 아무것도 소비하지 않는다.
    """
    client = _require_supabase()
    user_id = _require_user_id(authorization)

    total_cost = GACHA_COST_PER_PULL * payload.pulls

    # 1) 카탈로그와 기존 보유 목록 조회 (is_new 판정용)
    try:
        catalog_response = (
            client.table("gacha_items")
            .select("code, name, emoji, rarity, description")
            .eq("is_active", True)
            .execute()
        )
    except Exception as exc:
        raise _gamification_db_error(exc, "가챠 카탈로그 조회") from exc
    catalog = getattr(catalog_response, "data", None) or []
    if not catalog:
        raise HTTPException(
            status_code=503,
            detail="가챠 카탈로그가 비어 있습니다. supabase_gamification.sql 의 시드 데이터를 확인해 주세요.",
        )

    try:
        owned_response = (
            client.table("user_inventory")
            .select("item_code, quantity")
            .eq("user_id", user_id)
            .gt("quantity", 0)
            .execute()
        )
    except Exception as exc:
        raise _gamification_db_error(exc, "인벤토리 조회") from exc
    owned_before = {
        str(row["item_code"]) for row in (getattr(owned_response, "data", None) or [])
    }

    # 2) 추첨 (여기서 코인은 아직 건드리지 않는다)
    rolled = _roll_gacha(catalog, payload.pulls)

    # 3) 차감 + 지급을 한 번의 함수 호출(=한 트랜잭션)로 처리
    quantities: Dict[str, int] = {}
    for item in rolled:
        quantities[str(item["code"])] = quantities.get(str(item["code"]), 0) + 1
    rpc_items = [{"code": code, "qty": qty} for code, qty in quantities.items()]

    result = _call_rpc(
        client,
        "pull_gacha",
        {
            "p_user_id": user_id,
            "p_total_cost": total_cost,
            "p_items": rpc_items,
            "p_metadata": {"label": "가챠 뽑기", "pulls": payload.pulls},
        },
        "가챠 뽑기",
    )
    if not isinstance(result, dict) or "state" not in result:
        raise HTTPException(status_code=502, detail="가챠 결과를 해석할 수 없습니다.")

    seen: set = set()
    results: List[GachaResultItem] = []
    for item in rolled:
        code = str(item["code"])
        is_new = code not in owned_before and code not in seen
        seen.add(code)
        results.append(
            GachaResultItem(
                code=code,
                name=str(item.get("name") or code),
                emoji=str(item.get("emoji") or ""),
                rarity=str(item.get("rarity") or "common"),
                description=item.get("description"),
                is_new=is_new,
            )
        )

    return GachaResponse(
        results=results,
        pulls=payload.pulls,
        cost_per_pull=GACHA_COST_PER_PULL,
        spent=total_cost,
        state=_game_state_response(result["state"]),
    )


@app.get("/api/game/inventory", response_model=InventoryResponse)
async def get_inventory(authorization: Optional[str] = Header(default=None)):
    """카탈로그 전체와 본인 보유/배치 상태를 합쳐서 돌려준다.

    미획득 아이템도 quantity=0으로 함께 내려주므로, 기숙사 화면이 "무엇을 더
    뽑아야 하는지"를 추가 요청 없이 보여줄 수 있다.
    """
    client = _require_supabase()
    user_id = _require_user_id(authorization)

    try:
        catalog_response = (
            client.table("gacha_items")
            .select("code, name, emoji, rarity, description, sort_order")
            .eq("is_active", True)
            .order("sort_order")
            .execute()
        )
    except Exception as exc:
        raise _gamification_db_error(exc, "가챠 카탈로그 조회") from exc

    try:
        inventory_response = (
            client.table("user_inventory")
            .select("item_code, quantity, is_placed, pos_x, pos_y, z_index")
            .eq("user_id", user_id)
            .execute()
        )
    except Exception as exc:
        raise _gamification_db_error(exc, "인벤토리 조회") from exc

    owned = {
        str(row["item_code"]): row
        for row in (getattr(inventory_response, "data", None) or [])
    }

    items: List[InventoryItem] = []
    for entry in getattr(catalog_response, "data", None) or []:
        code = str(entry["code"])
        mine = owned.get(code, {})
        items.append(
            InventoryItem(
                code=code,
                name=str(entry.get("name") or code),
                emoji=str(entry.get("emoji") or ""),
                rarity=str(entry.get("rarity") or "common"),
                description=entry.get("description"),
                quantity=_int_or_zero(mine.get("quantity")),
                is_placed=bool(mine.get("is_placed")),
                pos_x=_optional_float(mine.get("pos_x")),
                pos_y=_optional_float(mine.get("pos_y")),
                z_index=_int_or_zero(mine.get("z_index")),
            )
        )

    return InventoryResponse(
        items=items,
        owned_count=sum(1 for item in items if item.quantity > 0),
        catalog_count=len(items),
        placed_count=sum(1 for item in items if item.is_placed),
        cost_per_pull=GACHA_COST_PER_PULL,
    )


@app.post("/api/game/inventory/place", response_model=InventoryResponse)
async def place_inventory(
    payload: PlacementRequest,
    authorization: Optional[str] = Header(default=None),
):
    """기숙사 책상 배치 좌표를 저장한다.

    좌표는 0~1 정규화 값이므로 책상 위젯 크기가 바뀌어도 배치가 유지된다.
    보유하지 않은 아이템을 배치하려 하면 400으로 거부한다. (insert가 아니라
    update만 하기 때문에, 없는 보유 행을 만들어 아이템을 공짜로 얻는 경로가 없다.)
    """
    client = _require_supabase()
    user_id = _require_user_id(authorization)

    codes = [item.item_code for item in payload.items]
    if len(set(codes)) != len(codes):
        raise HTTPException(status_code=400, detail="같은 아이템이 중복으로 들어 있습니다.")

    for item in payload.items:
        if item.is_placed and (item.pos_x is None or item.pos_y is None):
            raise HTTPException(
                status_code=400,
                detail=f"'{item.item_code}'를 배치하려면 pos_x와 pos_y가 필요합니다.",
            )

        update: Dict[str, Any] = {
            "is_placed": item.is_placed,
            "pos_x": item.pos_x,
            "pos_y": item.pos_y,
            "z_index": item.z_index,
        }
        try:
            response = (
                client.table("user_inventory")
                .update(update)
                .eq("user_id", user_id)
                .eq("item_code", item.item_code)
                .gt("quantity", 0)
                .execute()
            )
        except Exception as exc:
            raise _gamification_db_error(exc, "배치 저장") from exc

        if not (getattr(response, "data", None) or []):
            raise HTTPException(
                status_code=400,
                detail=f"'{item.item_code}'를 보유하고 있지 않아 배치할 수 없습니다.",
            )

    return await get_inventory(authorization=authorization)


@app.get("/api/game/leaderboard", response_model=LeaderboardResponse)
async def get_leaderboard(
    limit: int = Query(
        default=LEADERBOARD_DEFAULT_LIMIT, ge=1, le=LEADERBOARD_MAX_LIMIT, description="노출 인원"
    ),
    authorization: Optional[str] = Header(default=None),
):
    """이번 주(월요일 00:00 UTC 기준) 획득 코인 순위를 돌려준다.

    weekly_leaderboard 뷰는 security_invoker라서 프론트엔드가 anon 키로 직접
    조회하면 본인 행만 보인다. 남의 순위를 합쳐서 보여 주는 것은 이 엔드포인트
    뿐이고, 여기서도 표시 이름과 집계값만 내려준다(이메일·user_id 비노출).
    """
    client = _require_supabase()
    user_id = _require_user_id(authorization)

    try:
        top_response = (
            client.table("weekly_leaderboard")
            .select("*")
            .order("rank")
            .limit(limit)
            .execute()
        )
    except Exception as exc:
        raise _gamification_db_error(exc, "리더보드 조회") from exc

    def _entry(row: Dict[str, Any]) -> LeaderboardEntry:
        tier = _tier_for_xp(0)
        for candidate in TIER_THRESHOLDS:
            if candidate.level == _int_or_zero(row.get("tier_level")):
                tier = candidate
                break
        return LeaderboardEntry(
            rank=_int_or_zero(row.get("rank")),
            display_name=str(row.get("display_name") or "Student"),
            tier_level=tier.level,
            tier_name=tier.name,
            tier_emoji=tier.emoji,
            coins_earned=_int_or_zero(row.get("coins_earned")),
            attempts=_int_or_zero(row.get("attempts")),
            avg_score=_optional_float(row.get("avg_score")),
            streak_days=_int_or_zero(row.get("streak_days")),
            is_me=str(row.get("user_id")) == user_id,
        )

    rows = getattr(top_response, "data", None) or []
    entries = [_entry(row) for row in rows]
    week_start = rows[0].get("week_start_at") if rows else None

    # 본인이 상위권 밖이면 따로 한 줄 더 가져온다 (내 순위를 항상 보여 주기 위해)
    me = next((entry for entry in entries if entry.is_me), None)
    if me is None:
        try:
            my_response = (
                client.table("weekly_leaderboard")
                .select("*")
                .eq("user_id", user_id)
                .limit(1)
                .execute()
            )
        except Exception as exc:
            raise _gamification_db_error(exc, "본인 순위 조회") from exc
        my_rows = getattr(my_response, "data", None) or []
        if my_rows:
            me = _entry(my_rows[0])
            week_start = week_start or my_rows[0].get("week_start_at")

    return LeaderboardResponse(
        entries=entries,
        me=me,
        week_start_at=week_start,
        limit=limit,
    )


@app.get("/api/game/mistakes", response_model=MistakeListResponse)
async def list_mistakes(
    section: Optional[Literal["writing", "speaking", "reading", "listening", "vocabulary"]] = Query(
        default=None, description="섹션 필터 (생략 시 전체)"
    ),
    unresolved_only: bool = Query(
        default=True, description="아직 못 맞힌 오답만 (보스 레이드 기본값)"
    ),
    limit: int = Query(default=20, ge=1, le=100, description="가져올 문제 수"),
    authorization: Optional[str] = Header(default=None),
):
    """Memory Boss Raid가 꺼내 쓸 오답 목록을 돌려준다.

    기본값은 "아직 극복하지 못한 오답"만, 최근에 틀린 순서다. 보스 HP는
    unresolved_count로 계산하면 된다.
    """
    client = _require_supabase()
    user_id = _require_user_id(authorization)

    query = client.table("mistake_records").select("*").eq("user_id", user_id)
    if section:
        query = query.eq("section", section)
    if unresolved_only:
        query = query.is_("last_correct_at", "null")

    try:
        response = query.order("last_wrong_at", desc=True).limit(limit).execute()
    except Exception as exc:
        raise _gamification_db_error(exc, "오답 목록 조회") from exc

    items = [_mistake_item(row) for row in (getattr(response, "data", None) or [])]

    # 보스 HP 계산용 전체 미극복 건수 (limit과 무관하게 세야 한다)
    count_query = (
        client.table("mistake_records")
        .select("id", count="exact")
        .eq("user_id", user_id)
        .is_("last_correct_at", "null")
    )
    if section:
        count_query = count_query.eq("section", section)
    try:
        count_response = count_query.limit(1).execute()
        unresolved_count = _int_or_zero(getattr(count_response, "count", None))
    except Exception as exc:
        raise _gamification_db_error(exc, "오답 집계") from exc

    return MistakeListResponse(items=items, unresolved_count=unresolved_count, limit=limit)


@app.post("/api/game/mistakes", response_model=MistakeItem)
async def record_mistake(
    payload: MistakeCreateRequest,
    authorization: Optional[str] = Header(default=None),
):
    """틀린 문제를 기록한다 (보스 레이드 문제 풀에 넣는다).

    같은 문제를 또 틀리면 새 행을 만들지 않고 mistake_count를 올린다. 동일
    문제 판정 키(question_key)는 서버가 지문을 정규화해 해시하므로 클라이언트가
    임의로 지정할 수 없다.
    """
    client = _require_supabase()
    user_id = _require_user_id(authorization)

    question_key = _question_key(payload.section, payload.question_prompt)
    now_iso = datetime.now(timezone.utc).isoformat()

    try:
        existing_response = (
            client.table("mistake_records")
            .select("id, mistake_count")
            .eq("user_id", user_id)
            .eq("question_key", question_key)
            .limit(1)
            .execute()
        )
    except Exception as exc:
        raise _gamification_db_error(exc, "오답 기록") from exc

    existing = getattr(existing_response, "data", None) or []
    try:
        if existing:
            response = (
                client.table("mistake_records")
                .update({
                    "mistake_count": _int_or_zero(existing[0].get("mistake_count")) + 1,
                    "last_wrong_at": now_iso,
                    "user_answer": payload.user_answer,
                    "correct_answer": payload.correct_answer,
                    "explanation": payload.explanation,
                })
                .eq("id", existing[0]["id"])
                .eq("user_id", user_id)
                .execute()
            )
        else:
            response = (
                client.table("mistake_records")
                .insert({
                    "user_id": user_id,
                    "submission_id": payload.submission_id,
                    "section": payload.section,
                    "question_key": question_key,
                    "question_prompt": payload.question_prompt,
                    "user_answer": payload.user_answer,
                    "correct_answer": payload.correct_answer,
                    "explanation": payload.explanation,
                    "last_wrong_at": now_iso,
                })
                .execute()
            )
    except Exception as exc:
        raise _gamification_db_error(exc, "오답 기록") from exc

    rows = getattr(response, "data", None) or []
    if not rows:
        raise HTTPException(status_code=502, detail="오답 기록 결과를 받지 못했습니다.")
    return _mistake_item(rows[0])


@app.post("/api/game/mistakes/{mistake_id}/retry", response_model=MistakeRetryResponse)
async def retry_mistake(
    mistake_id: str,
    payload: MistakeRetryRequest,
    authorization: Optional[str] = Header(default=None),
):
    """오답 재도전 결과를 기록하고, 처음 극복했다면 코인을 지급한다.

    보상(mistake_cleared)은 서버 전용 사유다. 클라이언트가 "극복했다"고 주장해도
    여기서 정답 여부를 받아 기록한 뒤 서버가 직접 지급하며, 같은 오답으로는
    원장을 확인해 한 번만 지급한다.
    """
    client = _require_supabase()
    user_id = _require_user_id(authorization)

    try:
        found = (
            client.table("mistake_records")
            .select("*")
            .eq("id", mistake_id)
            .eq("user_id", user_id)
            .limit(1)
            .execute()
        )
    except Exception as exc:
        # UUID 형식이 아닌 값도 여기로 온다. 존재 여부를 흘리지 않도록 404로 정리한다.
        logger.warning("오답 조회 실패 (%s): %s", mistake_id, exc)
        raise HTTPException(status_code=404, detail="해당 오답 기록을 찾을 수 없습니다.") from exc

    rows = getattr(found, "data", None) or []
    if not rows:
        raise HTTPException(status_code=404, detail="해당 오답 기록을 찾을 수 없습니다.")
    row = rows[0]
    was_resolved = row.get("last_correct_at") is not None

    now_iso = datetime.now(timezone.utc).isoformat()
    update: Dict[str, Any] = {"retry_count": _int_or_zero(row.get("retry_count")) + 1}
    if payload.correct:
        update["last_correct_at"] = now_iso
    else:
        update["last_wrong_at"] = now_iso
        update["mistake_count"] = _int_or_zero(row.get("mistake_count")) + 1

    try:
        updated = (
            client.table("mistake_records")
            .update(update)
            .eq("id", mistake_id)
            .eq("user_id", user_id)
            .execute()
        )
    except Exception as exc:
        raise _gamification_db_error(exc, "오답 재도전 기록") from exc

    updated_rows = getattr(updated, "data", None) or []
    mistake = _mistake_item(updated_rows[0] if updated_rows else row)

    # 처음 극복했고, 이 오답으로 지급한 기록이 없을 때만 보상한다
    coins_awarded = 0
    state_row = _fetch_game_row(client, user_id)
    if payload.correct and not was_resolved and not _already_rewarded(
        client, user_id, "mistake_cleared", "mistake_id", mistake_id
    ):
        result = _apply_coins(
            client,
            user_id,
            MISTAKE_CLEARED_COINS,
            "mistake_cleared",
            MISTAKE_CLEARED_DAILY_CAP,
            MISTAKE_CLEARED_XP,
            {"label": "오답 극복", "mistake_id": mistake_id, "section": mistake.section},
        )
        coins_awarded = _int_or_zero(result.get("applied"))
        state_row = result["state"]
        activity = _call_rpc(
            client,
            "touch_activity",
            {
                "p_user_id": user_id,
                "p_xp": 0,
                "p_tier_level": _tier_for_xp(_int_or_zero(state_row.get("xp"))).level,
            },
            "활동 기록 갱신",
        )
        if isinstance(activity, dict):
            state_row = activity

    return MistakeRetryResponse(
        mistake=mistake,
        coins_awarded=coins_awarded,
        state=_game_state_response(state_row),
    )
